{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "amc/custom-section",
	"version": "0.1.0",
	"title": "Custom report section",
	"category": "widgets",
	"icon": "media-document",
	"description": "A custom section with a title and free content, insertable anywhere in a report.",
	"keywords": [ "amc", "report" ],
	"textdomain": "rtcamp-amc-copilot",
	"attributes": {
		"title": {
			"type": "string",
			"default": ""
		},
		"carryForward": {
			"type": "boolean",
			"default": false
		}
	},
	"supports": {
		"html": false,
		"multiple": true,
		"reusable": false,
		"inserter": true,
		"lock": false,
		"color": {
			"background": true,
			"text": true
		},
		"spacing": {
			"margin": true,
			"padding": true
		},
		"typography": {
			"fontSize": true
		},
		"__experimentalBorder": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		}
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css"
}
